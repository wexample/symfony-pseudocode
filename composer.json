{
  "name": "wexample/symfony-pseudocode",
  "description": "A basic PHP package",
  "type": "library",
  "license": "MIT",
  "version": "4.0.4",
  "authors": [
    {
      "name": "Wexample",
      "email": "contact@wexample.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.5",
    "wexample/php-pseudocode": ">=3.0.0",
    "wexample/symfony-helpers": ">=19.1.0"
  },
  "require-dev": {
    "symfony/http-kernel": "^6.0",
    "symfony/console": "^6.0",
    "symfony/framework-bundle": "^6.0",
    "phpunit/phpunit": "^13"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyPseudocode\\": "src/"
    }
  },
  "extra": {
